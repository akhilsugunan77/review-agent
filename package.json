{
  "name": "review-agent",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "deploy": "alchemy deploy",
    "plan": "alchemy plan",
    "dev": "alchemy dev",
    "destroy": "alchemy destroy",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.4",
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.2",
    "@types/node": "^26.6.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1"
}
